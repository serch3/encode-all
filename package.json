{
  "name": "encode-all",
  "version": "0.9.0",
  "description": "A cross-platform desktop app for batch video encoding with FFmpeg.",
  "main": "./out/main/index.js",
  "author": "Sergio Mandujano",
  "homepage": "https://github.com/serch3/encode-all",
  "repository": {
    "type": "git",
    "url": "https://github.com/serch3/encode-all.git"
  },
  "bugs": {
    "url": "https://github.com/serch3/encode-all/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "npm run install:electron && electron-vite preview",
    "dev": "npm run install:electron && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.ts --passWithNoTests",
    "test:ffmpeg": "node scripts/verify-ffmpeg.mjs",
    "test:watch": "jest --watch --config jest.config.ts",
    "test:coverage": "jest --coverage --config jest.config.ts",
    "test:ci": "jest --ci --runInBand --coverage --config jest.config.ts",
    "install:electron": "install-electron --no",
    "postinstall": "npm run install:electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@heroui/react": "^2.8.10",
    "@swc/core": "^1.16.18",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "framer-motion": "^12.43.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lucide-react": "^0.577.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "^4.1.3"
    }
  }
}
